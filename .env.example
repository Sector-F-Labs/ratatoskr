# Ratatoskr Environment Variables

# Required: Your Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Comma-separated Kafka broker list (default: localhost:9092)
KAFKA_BROKERS=localhost:9092

# Optional: Prefix for Kafka topics; topics become {prefix}.in / {prefix}.out (default: ratatoskr)
KAFKA_TOPIC_PREFIX=ratatoskr
